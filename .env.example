COMPOSE__POSTGRES__DB=ddos_guard
COMPOSE__POSTGRES__USER=ddos_guard
COMPOSE__POSTGRES__PASSWORD=ddos_guard
COMPOSE__POSTGRES__HOST=127.0.0.1
COMPOSE__POSTGRES__PORT=5432
COMPOSE__NGINX__HOST=127.0.0.1
COMPOSE__NGINX__HTTP_PORT=8080
COMPOSE__NGINX__HTTPS_PORT=8443
